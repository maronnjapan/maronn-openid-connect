{
  "name": "@maronn-oidc/experimental",
  "version": "0.0.3",
  "description": "Experimental OAuth/OIDC extensions for maronn-oidc (unstable APIs)",
  "type": "module",
  "exports": {
    "./par": {
      "types": "./dist/par/index.d.ts",
      "import": "./dist/par/index.js"
    },
    "./token-exchange": {
      "types": "./dist/token-exchange/index.d.ts",
      "import": "./dist/token-exchange/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openid-connect",
    "oauth2.1",
    "experimental"
  ],
  "author": "maronnjapan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maronnjapan/maronn-oidc.git",
    "directory": "packages/experimental"
  },
  "bugs": {
    "url": "https://github.com/maronnjapan/maronn-oidc/issues"
  },
  "homepage": "https://github.com/maronnjapan/maronn-oidc/tree/main/packages/experimental#readme",
  "peerDependencies": {
    "@maronn-oidc/core": ">=0.2.0 <1.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@maronn-oidc/core": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
