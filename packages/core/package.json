{
  "name": "@maronn-openid-connect/core",
  "version": "0.1.1",
  "description": "OpenID Connect Provider core implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "openid-connect",
    "oauth2.1",
    "authentication"
  ],
  "author": "maronnjapan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maronnjapan/maronn-openid-connect.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/maronnjapan/maronn-openid-connect/issues"
  },
  "homepage": "https://github.com/maronnjapan/maronn-openid-connect/tree/main/packages/core#readme",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
