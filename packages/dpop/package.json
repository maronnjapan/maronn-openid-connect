{
  "name": "@maronn-openid-connect/dpop",
  "version": "0.0.0",
  "description": "OAuth 2.0 Demonstrating Proof of Possession (DPoP, RFC 9449) for maronn-openid-connect providers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openid-connect",
    "oauth2.1",
    "dpop",
    "rfc9449",
    "proof-of-possession",
    "sender-constrained-tokens"
  ],
  "author": "maronnjapan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maronnjapan/maronn-openid-connect.git",
    "directory": "packages/dpop"
  },
  "bugs": {
    "url": "https://github.com/maronnjapan/maronn-openid-connect/issues"
  },
  "homepage": "https://github.com/maronnjapan/maronn-openid-connect/tree/main/packages/dpop#readme",
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@maronn-openid-connect/test-reach": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
