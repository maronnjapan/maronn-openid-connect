{
  "name": "@maronn-openid-connect/sample-fastify-flyio",
  "version": "0.0.5",
  "private": true,
  "description": "Fastify sample app with OpenID Provider code generated by the CLI",
  "type": "module",
  "scripts": {
    "generate": "maronn-oidc generate fastify --output ./src/oidc-provider",
    "check:generated": "pnpm run generate && node scripts/check-generated.mjs",
    "build": "pnpm --filter @maronn-openid-connect/core build && tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --outfile=dist/server.js --sourcemap",
    "start": "node dist/server.js",
    "launch": "pnpm run build && pnpm run start",
    "test": "pnpm --filter @maronn-openid-connect/core run build && pnpm run typecheck && pnpm run test:conformance",
    "test:conformance": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maronn-openid-connect/core": "workspace:*"
  },
  "devDependencies": {
    "@maronn-openid-connect/cli": "workspace:*",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.12",
    "fastify": "^5.6.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
