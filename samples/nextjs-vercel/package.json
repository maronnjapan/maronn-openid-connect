{
  "name": "@maronn-openid-connect/sample-nextjs-vercel",
  "version": "0.0.5",
  "private": true,
  "description": "Next.js sample app with OpenID Provider code generated by the CLI",
  "type": "module",
  "scripts": {
    "generate": "maronn-oidc generate nextjs --enable device-authorization-grant --output ./src/app",
    "check:generated": "pnpm run generate && node scripts/check-generated.mjs",
    "build": "pnpm --filter @maronn-openid-connect/core --filter @maronn-openid-connect/experimental run build && next build",
    "start": "next start --hostname ${HOST:-127.0.0.1} --port ${PORT:-3010}",
    "launch": "pnpm run build && pnpm run start",
    "test": "pnpm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maronn-openid-connect/core": "workspace:*",
    "@maronn-openid-connect/experimental": "workspace:*"
  },
  "devDependencies": {
    "@maronn-openid-connect/cli": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2"
  }
}
